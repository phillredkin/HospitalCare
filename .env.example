# Copy to .env in the repository root and replace the SQL password.
# Single quotes preserve literal dollar signs in passwords.
HOSPITALCARE_SQL_CONNECTION_STRING='Server=tcp:hospitalcare-sql-dev.database.windows.net,1433;Initial Catalog=hospitalcare-db;User ID=hospitaladmin;Password=REPLACE_WITH_SQL_PASSWORD;Encrypt=True;TrustServerCertificate=False;Connection Timeout=60;Persist Security Info=False'
