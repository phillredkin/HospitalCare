n">patient_exists</bpmn:conditionExpression></bpmn:sequenceFlow><bpmn:sequenceFlow id="F034" sourceRef="G_PatientExists" targetRef="T23" name="Nie"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">!patient_exists</bpmn:conditionExpression></bpmn:sequenceFlow><bpmn:sequenceFlow id="F035" sourceRef="T22" targetRef="G_PatientMerge"></bpmn:sequenceFlow><bpmn:sequenceFlow id="F037" sourceRef="G_PatientMerge" targetRef="T24"></bpmn:sequenceFlow><bpmn:sequenceFlow id="F038" sourceRef="T24" targetRef="T25"></bpmn:sequenceFlow><bpmn:sequenceFlow id="F039" sourceRef="T25" targetRef="G_ExistingHospitalization"></bpmn:sequenceFlow><bpmn:sequenceFlow id="F041" sourceRef="T27" targetRef="T28"></bpmn:sequenceFlow><bpmn:sequenceFlow id="F044" sourceRef="T30" targetRef="T31"></bpmn:sequenceFlow><bpmn:sequenceFlow id="F045" sourceRef="T31" targetRef="T32"></bpmn:sequenceFlow><bpmn:sequenceFlow id="F046" sourceRef="T32" targetRef="T33"></bpmn:sequenceFlow><bpmn:sequenceFlow id="F047" sourceRef="T33" targetRef="G_ClinicalValid"></bpmn:sequenceFlow><bpmn:sequenceFlow id="F048" sourceRef="G_ClinicalValid" targetRef="T34" name="Nie"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">!valid_clinical</bpmn:conditionExpression></bpmn:sequenceFlow><bpmn:sequenceFlow id="F049" sourceRef="T34" targetRef="T27" name="Opraviť"></bpmn:sequenceFlow><bpmn:sequenceFlow id="F050" sourceRef="G_ClinicalValid" targetRef="T35" name="Áno"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">valid_clinical</bpmn:conditionExpression></bpmn:sequenceFlow><bpmn:sequenceFlow id="F052" sourceRef="T36" targetRef="T37"></bpmn:sequenceFlow><bpmn:sequenceFlow id="F054" sourceRef="T38" targetRef="T39"></bpmn:sequenceFlow><bpmn:sequenceFlow id="F055" sourceRef="T39" targetRef="G_HttpSuccess"></bpmn:sequenceFlow><bpmn:sequenceFlow id="F056" sourceRef="Timeout" targetRef="T42" name="Čas vypršal"></bpmn:sequenceFlow><bpmn:sequenceFlow id="F057" sourceRef="G_HttpSuccess" targetRef="T61" name="Áno"