<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bioc="http://bpmn.io/schema/bpmn/biocolor/1.0" id="Definitions_HospitalCare" targetNamespace="https://hospitalcare.local/bpmn" exporter="HospitalCare" exporterVersion="3.0"><bpmn:message id="Message_Request" name="Požiadavka na výpočet"/><bpmn:message id="Message_Response" name="Výsledok alebo chyba"/><bpmn:process id="P1" name="HospitalCare · Riadenie hospitalizácií" isExecutable="false"><bpmn:laneSet id="LaneSet_P1"><bpmn:lane id="Lane_Admin" name="Administrátor"><bpmn:flowNodeRef>Start_Admin</bpmn:flowNodeRef><bpmn:flowNodeRef>T01</bpmn:flowNodeRef><bpmn:flowNodeRef>T06</bpmn:flowNodeRef><bpmn:flowNodeRef>T07</bpmn:flowNodeRef><bpmn:flowNodeRef>G_AccountMode</bpmn:flowNodeRef><bpmn:flowNodeRef>T08</bpmn:flowNodeRef><bpmn:flowNodeRef>T09</bpmn:flowNodeRef><bpmn:flowNodeRef>G_AccountMerge</bpmn:flowNodeRef><bpmn:flowNodeRef>T14</bpmn:flowNodeRef></bpmn:lane><bpmn:lane id="Lane_App" name="Informačný systém · Frontend + C# API"><bpmn:flowNodeRef>T02</bpmn:flowNodeRef><bpmn:flowNodeRef>G_AdminAuth</bpmn:flowNodeRef><bpmn:flowNodeRef>T03</bpmn:flowNodeRef><bpmn:flowNodeRef>T04</bpmn:flowNodeRef><bpmn:flowNodeRef>T05</bpmn:flowNodeRef><bpmn:flowNodeRef>T10</bpmn:flowNodeRef><bpmn:flowNodeRef>G_AccountValid</bpmn:flowNodeRef><bpmn:flowNodeRef>T11</bpmn:flowNodeRef><bpmn:flowNodeRef>T12</bpmn:flowNodeRef><bpmn:flowNodeRef>T13</bpmn:flowNodeRef><bpmn:flowNodeRef>T15</bpmn:flowNodeRef><bpmn:flowNodeRef>End_Admin</bpmn:flowNodeRef><bpmn:flowNodeRef>T17</bpmn:flowNodeRef><bpmn:flowNodeRef>G_DoctorAuth</bpmn:flowNodeRef><bpmn:flowNodeRef>T18</bpmn:flowNodeRef><bpmn:flowNodeRef>T19</bpmn:flowNodeRef><bpmn:flowNodeRef>T20</bpmn:flowNodeRef><bpmn:flowNodeRef>T24</bpmn:flowNodeRef><bpmn:flowNodeRef>T33</bpmn:flowNodeRef><bpmn:flowNodeRef>G_ClinicalValid</bpmn:flowNodeRef><bpmn:flowNodeRef>T34</bpmn:flowNodeRef><bpmn:flowNodeRef>T35</bpmn:flowNodeRef><bpmn:flowNodeRef>T37</bpmn:flowNodeRef><bpmn:flowNodeRef>T38</bpmn:flowNodeRef><bpmn:flowNodeRef>T39</bpmn:flowNodeRef><bpmn:flowNodeRef>Timeout</bpmn:flowNodeRef><bpmn:flowNodeRef>T40</bpmn:flowNodeRef><bpmn:flowNodeRef>T42</bpmn:flowNodeRef><bpmn:flowNodeRef>T43</bpmn:flowNodeRef><bpmn:flowNodeRef>G_Retry</bpmn:flowNodeRef><bpmn:flowNodeRef>T45</bpmn:flowNodeRef><bpmn:flowNodeRef>End_Doctor</bpmn:flowNodeRef><bpmn:flowNodeRef>T61</bpmn:flowNodeRef><bpmn:flowNodeRef>T62</bpmn:flowNodeRef><bpmn:flowNodeRef>G_ExistingHospitalization</bpmn:flowNodeRef><bpmn:flowNodeRef>T63</bpmn:flowNodeRef><bpmn:flowNodeRef>G_CacheHit</bpmn:flowNodeRef><bpmn:flowNodeRef>T64</bpmn:flowNodeRef><bpmn:flowNodeRef>T65</bpmn:flowNodeRef><bpmn:flowNodeRef>G_StoredPrediction</bpmn:flowNodeRef><bpmn:flowNodeRef>T66</bpmn:flowNodeRef><bpmn:flowNodeRef>T67</bpmn:flowNodeRef><bpmn:flowNodeRef>G_OpenMerge</bpmn:flowNodeRef><bpmn:flowNodeRef>G_ResultStatus</bpmn:flowNodeRef><bpmn:flowNodeRef>T68</bpmn:flowNodeRef><bpmn:flowNodeRef>G_DoctorAction</bpmn:flowNodeRef><bpmn:flowNodeRef>G_LoadedResult</bpmn:flowNodeRef><bpmn:flowNodeRef>CacheLoadError</bpmn:flowNodeRef><bpmn:flowNodeRef>G_HttpSuccess</bpmn:flowNodeRef><bpmn:flowNodeRef>T69</bpmn:flowNodeRef><bpmn:flowNodeRef>T70</bpmn:flowNodeRef><bpmn:flowNodeRef>G_PatientSaveMode</bpmn:flowNodeRef><bpmn:flowNodeRef>T71</bpmn:flowNodeRef><bpmn:flowNodeRef>G_PredictionInputs</bpmn:flowNodeRef><bpmn:flowNodeRef>T72</bpmn:flowNodeRef></bpmn:lane><bpmn:lane id="Lane_Doctor" name="Lekár"><bpmn:flowNodeRef>Start_Doctor</bpmn:flowNodeRef><bpmn:flowNodeRef>T16</bpmn:flowNodeRef><bpmn:flowNodeRef>T21</bpmn:flowNodeRef><bpmn:flowNodeRef>G_PatientExists</bpmn:flowNodeRef><bpmn:flowNodeRef>T22</bpmn:flowNodeRef><bpmn:flowNodeRef>T23</bpmn:flowNodeRef><bpmn:flowNodeRef>G_PatientMerge</bpmn:flowNodeRef><bpmn:flowNodeRef>T25</bpmn:flowNodeRef><bpmn:flowNodeRef>T26</bpmn:flowNodeRef><bpmn:flowNodeRef>T27</bpmn:flowNodeRef><bpmn:flowNodeRef>T28</bpmn:flowNodeRef><bpmn:flowNodeRef>T29</bpmn:flowNodeRef><bpmn:flowNodeRef>T30</bpmn:flowNodeRef><bpmn:flowNodeRef>T31</bpmn:flowNodeRef><bpmn:flowNodeRef>T32</bpmn:flowNodeRef><bpmn:flowNodeRef>T36</bpmn:flowNodeRef><bpmn:flowNodeRef>T41</bpmn:flowNodeRef><bpmn:flowNodeRef>T44</bpmn:flowNodeRef></bpmn:lane></bpmn:laneSet><bpmn:startEvent id="Start_Admin" name="Správa IS"><bpmn:outgoing>F001</bpmn:outgoing></bpmn:startEvent><bpmn:userTask id="T01" name="Zadať prihlasovacie údaje"><bpmn:documentation>Pôvodný názov: Zadať prihlasovacie údaje.</bpmn:documentation><bpmn:incoming>F001</bpmn:incoming><bpmn:incoming>F005</bpmn:incoming><bpmn:outgoing>F002</bpmn:outgoing></bpmn:userTask><bpmn:serviceTask id="T02" name="Overiť administrátora"><bpmn:documentation>Pôvodný názov: Overiť administrátora.</bpmn:documentation><bpmn:incoming>F002</bpmn:incoming><bpmn:outgoing>F003</bpmn:outgoing></bpmn:serviceTask><bpmn:exclusiveGateway id="G_AdminAuth" name="Prihlásenie platné?" gatewayDirection="Diverging"><bpmn:incoming>F003</bpmn:incoming><bpmn:outgoing>F004</bpmn:outgoing><bpmn:outgoing>F006</bpmn:outgoing></bpmn:exclusiveGateway><bpmn:serviceTask id="T03" name="Zobraziť chybu prihlásenia"><bpmn:documentation>Pôvodný názov: Zobraziť chybu prihlásenia.</bpmn:documentation><bpmn:incoming>F004</bpmn:incoming><bpmn:outgoing>F005</bpmn:outgoing></bpmn:serviceTask><bpmn:serviceTask id="T04" name="Vytvoriť reláciu administrátora"><bpmn:documentation>Pôvodný názov: Vytvoriť session administrátora.</bpmn:documentation><bpmn:incoming>F006</bpmn:incoming><bpmn:outgoing>F007</bpmn:outgoing></bpmn:serviceTask><bpmn:serviceTask id="T05" name="Zobraziť prehľad systému"><bpmn:documentation>Pôvodný názov: Zobraziť súhrn IS.</bpmn:documentation><bpmn:incoming>F007</bpmn:incoming><bpmn:outgoing>F008</bpmn:outgoing></bpmn:serviceTask><bpmn:userTask id="T06" name="Otvoriť správu používateľov"><bpmn:documentation>Pôvodný názov: Otvoriť správu používateľov.</bpmn:documentation><bpmn:incoming>F008</bpmn:incoming><bpmn:outgoing>F009</bpmn:outgoing></bpmn:userTask><bpmn:userTask id="T07" name="Vybrať používateľský účet"><bpmn:documentation>Pôvodný názov: Vybrať účet alebo nový účet.</bpmn:documentation><bpmn:incoming>F009</bpmn:incoming><bpmn:incoming>F018</bpmn:incoming><bpmn:outgoing>F010</bpmn:outgoing></bpmn:userTask><bpmn:exclusiveGateway id="G_AccountMode" name="Nový účet?" gatewayDirection="Diverging"><bpmn:incoming>F010</bpmn:incoming><bpmn:outgoing>F011</bpmn:outgoing><bpmn:outgoing>F012</bpmn:outgoing></bpmn:exclusiveGateway><bpmn:userTask id="T08" name="Vyplniť nový účet"><bpmn:documentation>Pôvodný názov: Vyplniť nový účet.</bpmn:documentation><bpmn:incoming>F011</bpmn:incoming><bpmn:outgoing>F013</bpmn:outgoing></bpmn:userTask><bpmn:userTask id="T09" name="Upraviť rolu a stav účtu"><bpmn:documentation>Pôvodný názov: Upraviť rolu a stav účtu.</bpmn:documentation><bpmn:incoming>F012</bpmn:incoming><bpmn:outgoing>F014</bpmn:outgoing></bpmn:userTask><bpmn:exclusiveGateway id="G_AccountMerge" gatewayDirection="Converging"><bpmn:incoming>F013</bpmn:incoming><bpmn:incoming>F014</bpmn:incoming><bpmn:outgoing>F015</bpmn:outgoing></bpmn:exclusiveGateway><bpmn:serviceTask id="T10" name="Overiť údaje účtu"><bpmn:documentation>Pôvodný názov: Overiť údaje účtu.</bpmn:documentation><bpmn:incoming>F015</bpmn:incoming><bpmn:outgoing>F016</bpmn:outgoing></bpmn:serviceTask><bpmn:exclusiveGateway id="G_AccountValid" name="Údaje platné?" gatewayDirection="Diverging"><bpmn:incoming>F016</bpmn:incoming><bpmn:outgoing>F017</bpmn:outgoing><bpmn:outgoing>F019</bpmn:outgoing></bpmn:exclusiveGateway><bpmn:serviceTask id="T11" name="Zobraziť chyby účtu"><bpmn:documentation>Pôvodný názov: Zobraziť chyby účtu.</bpmn:documentation><bpmn:incoming>F017</bpmn:incoming><bpmn:outgoing>F018</bpmn:outgoing></bpmn:serviceTask><bpmn:serviceTask id="T12" name="Uložiť účet do Azure SQL"><bpmn:documentation>Pôvodný názov: Uložiť účet do IS DB.</bpmn:documentation><bpmn:incoming>F019</bpmn:incoming><bpmn:outgoing>F020</bpmn:outgoing></bpmn:serviceTask><bpmn:serviceTask id="T13" name="Zobraziť výsledok zmeny"><bpmn:documentation>Pôvodný názov: Zobraziť výsledok zmeny.</bpmn:documentation><bpmn:incoming>F020</bpmn:incoming><bpmn:outgoing>F021</bpmn:outgoing></bpmn:serviceTask><bpmn:userTask id="T14" name="Odhlásiť administrátora"><bpmn:documentation>Pôvodný názov: Odhlásiť administrátora.</bpmn:documentation><bpmn:incoming>F021</bpmn:incoming><bpmn:outgoing>F022</bpmn:outgoing></bpmn:userTask><bpmn:serviceTask id="T15" name="Zrušiť reláciu administrátora"><bpmn:documentation>Pôvodný názov: Zrušiť session administrátora.</bpmn:documentation><bpmn:incoming>F022</bpmn:incoming><bpmn:outgoing>F023</bpmn:outgoing></bpmn:serviceTask><bpmn:endEvent id="End_Admin" name="Odhlásený"><bpmn:incoming>F023</bpmn:incoming></bpmn:endEvent><bpmn:startEvent id="Start_Doctor" name="Práca lekára"><bpmn:outgoing>F024</bpmn:outgoing></bpmn:startEvent><bpmn:userTask id="T16" name="Zadať prihlasovacie údaje"><bpmn:documentation>Pôvodný názov: Zadať prihlasovacie údaje.</bpmn:documentation><bpmn:incoming>F024</bpmn:incoming><bpmn:incoming>F028</bpmn:incoming><bpmn:outgoing>F025</bpmn:outgoing></bpmn:userTask><bpmn:serviceTask id="T17" name="Overiť lekára"><bpmn:documentation>Pôvodný názov: Overiť lekára.</bpmn:documentation><bpmn:incoming>F025</bpmn:incoming><bpmn:outgoing>F026</bpmn:outgoing></bpmn:serviceTask><bpmn:exclusiveGateway id="G_DoctorAuth" name="Prihlásenie platné?" gatewayDirection="Diverging"><bpmn:incoming>F026</bpmn:incoming><bpmn:outgoing>F027</bpmn:outgoing><bpmn:outgoing>F029</bpmn:outgoing></bpmn:exclusiveGateway><bpmn:serviceTask id="T18" name="Zobraziť chybu prihlásenia"><bpmn:documentation>Pôvodný názov: Zobraziť chybu prihlásenia.</bpmn:documentation><bpmn:incoming>F027</bpmn:incoming><bpmn:outgoing>F028</bpmn:outgoing></bpmn:serviceTask><bpmn:serviceTask id="T19" name="Vytvoriť reláciu lekára"><bpmn:documentation>Pôvodný názov: Vytvoriť session lekára.</bpmn:documentation><bpmn:incoming>F029</bpmn:incoming><bpmn:outgoing>F030</bpmn:outgoing></bpmn:serviceTask><bpmn:serviceTask id="T20" name="Načítať zoznam pacientov"><bpmn:documentation>Pôvodný názov: Načítať zoznam pacientov.</bpmn:documentation><bpmn:incoming>F030</bpmn:incoming><bpmn:outgoing>F031</bpmn:outgoing></bpmn:serviceTask><bpmn:userTask id="T21" name="Vyhľadať pacienta"><bpmn:documentation>Pôvodný názov: Vyhľadať pacienta.</bpmn:documentation><bpmn:incoming>F031</bpmn:incoming><bpmn:outgoing>F032</bpmn:outgoing></bpmn:userTask><bpmn:exclusiveGateway id="G_PatientExists" name="Pacient existuje?" gatewayDirection="Diverging"><bpmn:incoming>F032</bpmn:incoming><bpmn:outgoing>F033</bpmn:outgoing><bpmn:outgoing>F034</bpmn:outgoing></bpmn:exclusiveGateway><bpmn:userTask id="T22" name="Otvoriť kartu pacienta"><bpmn:documentation>Pôvodný názov: Otvoriť kartu pacienta.</bpmn:documentation><bpmn:incoming>F033</bpmn:incoming><bpmn:outgoing>F035</bpmn:outgoing></bpmn:userTask><bpmn:userTask id="T23" name="Otvoriť formulár pacienta"><bpmn:documentation>Otvoriť PatientForm v režime vytvorenia. Pacient sa do Azure SQL uloží až v T69 po zadaní údajov.
Pôvodný názov: Otvoriť formulár nového pacienta.</bpmn:documentation><bpmn:incoming>F034</bpmn:incoming><bpmn:outgoing>F156</bpmn:outgoing></bpmn:userTask><bpmn:exclusiveGateway id="G_PatientMerge" gatewayDirection="Converging"><bpmn:incoming>F035</bpmn:incoming><bpmn:incoming>F160</bpmn:incoming><bpmn:outgoing>F037</bpmn:outgoing></bpmn:exclusiveGateway><bpmn:serviceTask id="T24" name="Načítať históriu hospitalizácií"><bpmn:documentation>Pôvodný názov: Načítať históriu hospitalizácií.</bpmn:documentation><bpmn:incoming>F037</bpmn:incoming><bpmn:outgoing>F038</bpmn:outgoing></bpmn:serviceTask><bpmn:userTask id="T25" name="Vybrať hospitalizáciu"><bpmn:documentation>Vybrať už uloženú hospitalizáciu s ID alebo otvoriť formulár novej hospitalizácie. Nový záznam a jeho ID vzniknú až úspešným uložením v T35.
Pôvodný názov: Zvoliť novú alebo otvoriť hospitalizáciu.</bpmn:documentation><bpmn:incoming>F038</bpmn:incoming><bpmn:outgoing>F039</bpmn:outgoing></bpmn:userTask><bpmn:userTask id="T26" name="Upraviť údaje pacienta"><bpmn:documentation>Samostatný PatientForm: meno, priezvisko, dátum narodenia, pohlavie a typ diabetu. Údaje sa odosielajú do /api/patients, nie v požiadavke na uloženie hospitalizácie.
Pôvodný názov: Zadať alebo upraviť údaje pacienta.</bpmn:documentation><bpmn:incoming>F156</bpmn:incoming><bpmn:incoming>F157</bpmn:incoming><bpmn:outgoing>F158</bpmn:outgoing></bpmn:userTask><bpmn:userTask id="T27" name="Zadať diagnózy hospitalizácie"><bpmn:documentation>HospitalizationForm obsahuje diag1, diag2 a diag3. Typ diabetu patrí pacientovi a ukladá sa samostatne cez PatientForm.
Pôvodný názov: Zadať diagnózy hospitalizácie.</bpmn:documentation><bpmn:incoming>F049</bpmn:incoming><bpmn:incoming>F100</bpmn:incoming><bpmn:incoming>F162</bpmn:incoming><bpmn:outgoing>F041</bpmn:outgoing></bpmn:userTask><bpmn:userTask id="T28" name="Zadať prijatie a prepustenie"><bpmn:documentation>Pôvodný názov: Zadať prijatie a prepustenie.</bpmn:documentation><bpmn:incoming>F041</bpmn:incoming><bpmn:outgoing>F163</bpmn:outgoing></bpmn:userTask><bpmn:userTask id="T29" name="Zadať liek a stav dávky"><bpmn:documentation>Samostatný MedicationForm pre už uloženú hospitalizáciu. Obsahuje medicationName a doseStatus; inzulín je jedným z možných liekov, nie osobitným poľom formulára hospitalizácie.
Pôvodný názov: Zadať liek a stav dávky.</bpmn:documentation><bpmn:incoming>F164</bpmn:incoming><bpmn:outgoing>F165</bpmn:outgoing></bpmn:userTask><bpmn:userTask id="T30" name="Zadať HbA1c a glykémiu"><bpmn:documentation>Pôvodný názov: Zadať HbA1c a glykémiu.</bpmn:documentation><bpmn:incoming>F163</bpmn:incoming><bpmn:outgoing>F044</bpmn:outgoing></bpmn:userTask><bpmn:userTask id="T31" name="Zadať počty výkonov a diagnóz"><bpmn:documentation>Pôvodný názov: Zadať počty výkonov a diagnóz.</bpmn:documentation><bpmn:incoming>F044</bpmn:incoming><bpmn:outgoing>F045</bpmn:outgoing></bpmn:userTask><bpmn:userTask id="T32" name="Zadať návštevy za posledný rok"><bpmn:documentation>Pôvodný názov: Zadať návštevy za posledný rok.</bpmn:documentation><bpmn:incoming>F045</bpmn:incoming><bpmn:outgoing>F046</bpmn:outgoing></bpmn:userTask><bpmn:serviceTask id="T33" name="Overiť údaje hospitalizácie"><bpmn:documentation>Validácia formulára a DTO hospitalizácie: dátumy, formáty, rozsahy a počty. Nullable polia môžu zostať nevyplnené. Úplnosť pre ML sa overuje osobitne až pred odoslaním predikcie.
Pôvodný názov: Overiť údaje hospitalizácie.</bpmn:documentation><bpmn:incoming>F046</bpmn:incoming><bpmn:outgoing>F047</bpmn:outgoing></bpmn:serviceTask><bpmn:exclusiveGateway id="G_ClinicalValid" name="Údaje platné?" gatewayDirection="Diverging"><bpmn:incoming>F047</bpmn:incoming><bpmn:outgoing>F048</bpmn:outgoing><bpmn:outgoing>F050</bpmn:outgoing></bpmn:exclusiveGateway><bpmn:serviceTask id="T34" name="Zobraziť chyby formulára"><bpmn:documentation>Pôvodný názov: Zobraziť chyby formulára.</bpmn:documentation><bpmn:incoming>F048</bpmn:incoming><bpmn:outgoing>F049</bpmn:outgoing></bpmn:serviceTask><bpmn:serviceTask id="T35" name="Uložiť hospitalizáciu do Azure SQL"><bpmn:documentation>POST/PATCH /api/hospitalizations uloží iba polia HospitalizationInput do Azure SQL. Neukladá demografické údaje pacienta, typ diabetu ani zoznam liekov. Výsledok poskytne ID potrebné na pridávanie liekov a poznámok.
Pôvodný názov: Uložiť hospitalizáciu do Azure SQL.</bpmn:documentation><bpmn:incoming>F050</bpmn:incoming><bpmn:outgoing>F119</bpmn:outgoing></bpmn:serviceTask><bpmn:userTask id="T36" name="Vyžiadať predikciu rizika"><bpmn:documentation>Pôvodný názov: Požiadať o predikciu pri prepustení.</bpmn:documentation><bpmn:incoming>F063</bpmn:incoming><bpmn:incoming>F116</bpmn:incoming><bpmn:outgoing>F052</bpmn:outgoing></bpmn:userTask><bpmn:serviceTask id="T37" name="Overiť oprávnenie požiadavky"><bpmn:documentation>C# middleware overí session cookie, rolu Admin/Doctor a CSRF hlavičku. Samostatný ML token sa nevydáva.
Pôvodný názov: Overiť session, rolu a CSRF na C# API.</bpmn:documentation><bpmn:incoming>F052</bpmn:incoming><bpmn:outgoing>F167</bpmn:outgoing></bpmn:serviceTask><bpmn:sendTask id="T38" name="Odoslať požiadavku do Python API"><bpmn:documentation>Po úspešnej kontrole vstupov vytvoriť nový request_id (Guid.NewGuid), zostaviť payload a odoslať POST /predict do Python API. Každý nový pokus z UI používa nový request_id.
Pôvodný názov: Odoslať požiadavku do Python API.</bpmn:documentation><bpmn:incoming>F169</bpmn:incoming><bpmn:outgoing>F054</bpmn:outgoing></bpmn:sendTask><bpmn:receiveTask id="T39" name="Prijať výsledok alebo chybu"><bpmn:documentation>Pôvodný názov: Prijať výsledok alebo chybu.</bpmn:documentation><bpmn:incoming>F054</bpmn:incoming><bpmn:outgoing>F055</bpmn:outgoing></bpmn:receiveTask><bpmn:boundaryEvent id="Timeout" name="30 s" attachedToRef="T39" cancelActivity="true"><bpmn:documentation>HttpClient MlService v backend/Program.cs má timeout 30 sekúnd. Nejde o automatický opakovaný pokus.</bpmn:documentation><bpmn:outgoing>F056</bpmn:outgoing><bpmn:timerEventDefinition id="EventDefinition_Timeout"><bpmn:timeDuration xsi:type="bpmn:tFormalExpression">PT30S</bpmn:timeDuration></bpmn:timerEventDefinition></bpmn:boundaryEvent><bpmn:serviceTask id="T40" name="Zobraziť riziko a faktory"><bpmn:documentation>UI zobrazuje percento rizika, úroveň rizika a vysvetľujúce faktory. Verzia modelu a čas sú v odpovedi API, ale aktuálne sa v tejto karte nezobrazujú.
Pôvodný názov: Zobraziť riziko a vysvetľujúce faktory.</bpmn:documentation><bpmn:incoming>F112</bpmn:incoming><bpmn:outgoing>F120</bpmn:outgoing></bpmn:serviceTask><bpmn:userTask id="T41" name="Zapísať klinickú poznámku"><bpmn:documentation>Samostatný formulár poznámky je dostupný pre vybranú hospitalizáciu aj bez predikcie, po chybe alebo pri stave unsupported.
Pôvodný názov: Zapísať klinickú poznámku a plán.</bpmn:documentation><bpmn:incoming>F117</bpmn:incoming><bpmn:outgoing>F122</bpmn:outgoing></bpmn:userTask><bpmn:serviceTask id="T42" name="Zobraziť chybu predikcie"><bpmn:documentation>Zobraziť HTTP chybu alebo timeout bez falošného rizika. Lekár môže zopakovať výpočet alebo ďalej pracovať s hospitalizáciou a poznámkou.
Pôvodný názov: Zobraziť chybu alebo nedostupnosť predikcie.</bpmn:documentation><bpmn:incoming>F056</bpmn:incoming><bpmn:incoming>F061</bpmn:incoming><bpmn:outgoing>F062</bpmn:outgoing></bpmn:serviceTask><bpmn:serviceTask id="T43" name="Uložiť poznámku do Azure SQL"><bpmn:documentation>POST /api/hospitalizations/{id}/clinical-notes. Autora určí backend zo session. Uloženie poznámky nezávisí od úspechu predikcie.
Pôvodný názov: Uložiť poznámku a plán do Azure SQL.</bpmn:documentation><bpmn:incoming>F122</bpmn:incoming><bpmn:outgoing>F123</bpmn:outgoing></bpmn:serviceTask><bpmn:exclusiveGateway id="G_Retry" name="Skúsiť znova?" gatewayDirection="Diverging"><bpmn:incoming>F062</bpmn:incoming><bpmn:outgoing>F063</bpmn:outgoing><bpmn:outgoing>F124</bpmn:outgoing></bpmn:exclusiveGateway><bpmn:userTask id="T44" name="Odhlásiť lekára"><bpmn:documentation>Pôvodný názov: Odhlásiť lekára.</bpmn:documentation><bpmn:incoming>F118</bpmn:incoming><bpmn:outgoing>F125</bpmn:outgoing></bpmn:userTask><bpmn:serviceTask id="T45" name="Zrušiť reláciu lekára"><bpmn:documentation>Pôvodný názov: Zrušiť session lekára.</bpmn:documentation><bpmn:incoming>F125</bpmn:incoming><bpmn:outgoing>F067</bpmn:outgoing></bpmn:serviceTask><bpmn:endEvent id="End_Doctor" name="Odhlásený"><bpmn:incoming>F067</bpmn:incoming></bpmn:endEvent><bpmn:serviceTask id="T61" name="Uložiť väzbu predikcie do Azure SQL"><bpmn:documentation>Po úspešnej HTTP odpovedi Python API uložiť PredictionLinks pre výsledok ok aj unsupported. Pri HTTP chybe sa táto väzba nevytvára.
Pôvodný názov: Uložiť väzbu výsledku na hospitalizáciu do Azure SQL.</bpmn:documentation><bpmn:incoming>F057</bpmn:incoming><bpmn:outgoing>F097</bpmn:outgoing></bpmn:serviceTask><bpmn:serviceTask id="T62" name="Uložiť výsledok do Redis na 24 hodín"><bpmn:documentation>Uložiť celý výsledok predikcie do Redis pod kľúčom prediction:hospitalization:{id} s absolútnou platnosťou 24 hodín. Nedostupnosť Redis nesmie zabrániť zobrazeniu výsledku.
Pôvodný názov: Uložiť výsledok do Redis (TTL 24 h).</bpmn:documentation><bpmn:incoming>F097</bpmn:incoming><bpmn:outgoing>F111</bpmn:outgoing></bpmn:serviceTask><bpmn:exclusiveGateway id="G_ExistingHospitalization" name="Existujúca hospitalizácia?" gatewayDirection="Diverging"><bpmn:incoming>F039</bpmn:incoming><bpmn:outgoing>F099</bpmn:outgoing><bpmn:outgoing>F100</bpmn:outgoing></bpmn:exclusiveGateway><bpmn:serviceTask id="T63" name="Vyhľadať predikciu v Redis"><bpmn:documentation>Pri otvorení existujúcej hospitalizácie najprv načítať kľúč prediction:hospitalization:{id}. Pri chýbajúcom alebo expirovanom kľúči, prípadne nedostupnosti Redis, pokračovať načítaním uloženého výsledku.
Pôvodný názov: Skontrolovať predikciu v Redis.</bpmn:documentation><bpmn:incoming>F099</bpmn:incoming><bpmn:outgoing>F101</bpmn:outgoing></bpmn:serviceTask><bpmn:exclusiveGateway id="G_CacheHit" name="Predikcia v Redis?" gatewayDirection="Diverging"><bpmn:incoming>F101</bpmn:incoming><bpmn:outgoing>F102</bpmn:outgoing><bpmn:outgoing>F103</bpmn:outgoing></bpmn:exclusiveGateway><bpmn:serviceTask id="T64" name="Zobraziť uložený výsledok"><bpmn:documentation>Pri status=ok zobraziť riziko a faktory; pri status=unsupported zobraziť dôvody bez percenta. Chyba načítania neblokuje ďalšiu prácu lekára.
Pôvodný názov: Zobraziť uložený výsledok alebo stav predikcie.</bpmn:documentation><bpmn:incoming>F102</bpmn:incoming><bpmn:incoming>F129</bpmn:incoming><bpmn:incoming>F130</bpmn:incoming><bpmn:outgoing>F109</bpmn:outgoing></bpmn:serviceTask><bpmn:serviceTask id="T65" name="Načítať väzbu predikcie z Azure SQL"><bpmn:documentation>V PredictionLinks vyhľadať posledný záznam pre HospitalizationId podľa CreatedAt a Id; načítať PredictionId. Ak záznam neexistuje, otvoriť formulár bez predikcie.
Pôvodný názov: Načítať poslednú väzbu predikcie z Azure SQL.</bpmn:documentation><bpmn:incoming>F103</bpmn:incoming><bpmn:outgoing>F104</bpmn:outgoing></bpmn:serviceTask><bpmn:exclusiveGateway id="G_StoredPrediction" name="Väzba nájdená?" gatewayDirection="Diverging"><bpmn:incoming>F104</bpmn:incoming><bpmn:outgoing>F105</bpmn:outgoing><bpmn:outgoing>F106</bpmn:outgoing></bpmn:exclusiveGateway><bpmn:serviceTask id="T66" name="Načítať výsledok cez Python API"><bpmn:documentation>Použiť GET /predictions/{predictionId}; Python API načíta už uložený výsledok z PostgreSQL. Nejde o POST /predict ani o nový výpočet modelu.
Pôvodný názov: Načítať výsledok z ML DB cez Python API.</bpmn:documentation><bpmn:incoming>F105</bpmn:incoming><bpmn:outgoing>F126</bpmn:outgoing></bpmn:serviceTask><bpmn:serviceTask id="T67" name="Obnoviť výsledok v Redis na 24 hodín"><bpmn:documentation>Načítaný výsledok uložiť do Redis pod kľúčom hospitalizácie s novou absolútnou platnosťou 24 hodín. Pri chybe Redis pokračovať zobrazením načítaného výsledku.
Pôvodný názov: Obnoviť výsledok v Redis (TTL 24 h).</bpmn:documentation><bpmn:incoming>F127</bpmn:incoming><bpmn:outgoing>F129</bpmn:outgoing></bpmn:serviceTask><bpmn:exclusiveGateway id="G_OpenMerge" gatewayDirection="Converging"><bpmn:incoming>F106</bpmn:incoming><bpmn:incoming>F109</bpmn:incoming><bpmn:incoming>F128</bpmn:incoming><bpmn:outgoing>F114</bpmn:outgoing></bpmn:exclusiveGateway><bpmn:exclusiveGateway id="G_ResultStatus" name="Stav výsledku?" gatewayDirection="Diverging"><bpmn:incoming>F111</bpmn:incoming><bpmn:outgoing>F112</bpmn:outgoing><bpmn:outgoing>F113</bpmn:outgoing></bpmn:exclusiveGateway><bpmn:serviceTask id="T68" name="Zobraziť dôvody nepodpory"><bpmn:documentation>Pri status=unsupported sa uložený výsledok zachová v PostgreSQL, Azure SQL a Redis. UI zobrazí dôvody a nevymýšľa percento rizika.
Pôvodný názov: Zobraziť dôvody nepodpory bez percenta.</bpmn:documentation><bpmn:incoming>F113</bpmn:incoming><bpmn:outgoing>F121</bpmn:outgoing></bpmn:serviceTask><bpmn:exclusiveGateway id="G_DoctorAction" name="Ďalšia činnosť?" gatewayDirection="Mixed"><bpmn:documentation>Činnosti pre už uloženú hospitalizáciu s platným ID. Pacient, hospitalizácia, lieky a poznámky majú samostatné formuláre a samostatné API zápisy.</bpmn:documentation><bpmn:incoming>F114</bpmn:incoming><bpmn:incoming>F119</bpmn:incoming><bpmn:incoming>F120</bpmn:incoming><bpmn:incoming>F121</bpmn:incoming><bpmn:incoming>F123</bpmn:incoming><bpmn:incoming>F124</bpmn:incoming><bpmn:incoming>F161</bpmn:incoming><bpmn:incoming>F166</bpmn:incoming><bpmn:incoming>F171</bpmn:incoming><bpmn:outgoing>F116</bpmn:outgoing><bpmn:outgoing>F117</bpmn:outgoing><bpmn:outgoing>F118</bpmn:outgoing><bpmn:outgoing>F157</bpmn:outgoing><bpmn:outgoing>F162</bpmn:outgoing><bpmn:outgoing>F164</bpmn:outgoing></bpmn:exclusiveGateway><bpmn:exclusiveGateway id="G_LoadedResult" name="Výsledok nájdený?" gatewayDirection="Diverging"><bpmn:incoming>F126</bpmn:incoming><bpmn:outgoing>F127</bpmn:outgoing><bpmn:outgoing>F128</bpmn:outgoing></bpmn:exclusiveGateway><bpmn:boundaryEvent id="CacheLoadError" name="Chyba načítania" attachedToRef="T66" cancelActivity="true"><bpmn:outgoing>F130</bpmn:outgoing><bpmn:errorEventDefinition id="EventDefinition_CacheLoadError"/></bpmn:boundaryEvent><bpmn:exclusiveGateway id="G_HttpSuccess" name="Odpoveď úspešná?" gatewayDirection="Diverging"><bpmn:incoming>F055</bpmn:incoming><bpmn:outgoing>F057</bpmn:outgoing><bpmn:outgoing>F061</bpmn:outgoing></bpmn:exclusiveGateway><bpmn:serviceTask id="T69" name="Uložiť pacienta do Azure SQL"><bpmn:documentation>PatientForm používa POST /api/patients pri vytvorení a PATCH /api/patients/{id} pri úprave. Backend uloží samostatný záznam pacienta. Pri chybe zostáva formulár otvorený so zadanými údajmi.
Pôvodný názov: Uložiť pacienta do Azure SQL.</bpmn:documentation><bpmn:incoming>F158</bpmn:incoming><bpmn:outgoing>F159</bpmn:outgoing></bpmn:serviceTask><bpmn:serviceTask id="T70" name="Uložiť liek do Azure SQL"><bpmn:documentation>POST /api/hospitalizations/{id}/medications. Backend overí existenciu hospitalizácie, údaje lieku a duplicitu. Lieky sa pridávajú až po vytvorení hospitalizácie. Počet NumMedications sa mení samostatne vo formulári hospitalizácie.
Pôvodný názov: Pridať liek ku hospitalizácii v Azure SQL.</bpmn:documentation><bpmn:incoming>F165</bpmn:incoming><bpmn:outgoing>F166</bpmn:outgoing></bpmn:serviceTask><bpmn:exclusiveGateway id="G_PatientSaveMode" name="Nový pacient uložený?" gatewayDirection="Diverging"><bpmn:incoming>F159</bpmn:incoming><bpmn:outgoing>F160</bpmn:outgoing><bpmn:outgoing>F161</bpmn:outgoing></bpmn:exclusiveGateway><bpmn:serviceTask id="T71" name="Načítať a overiť vstupy predikcie"><bpmn:documentation>MlPredictionService načíta hospitalizáciu, pacienta a lieky z Azure SQL. Pred Python volaním overí existenciu záznamu, dátum narodenia a vek pri prijatí, pohlavie, povinné kódy a počty, dĺžku pobytu, hlavnú diagnózu, stavy liekov a boolean hodnoty liečby. Pri chýbajúcom zázname vráti 404, pri neplatných alebo neúplných údajoch 400; Python sa nevolá.
Pôvodný názov: Načítať a overiť vstupy na C# API.</bpmn:documentation><bpmn:incoming>F167</bpmn:incoming><bpmn:outgoing>F168</bpmn:outgoing></bpmn:serviceTask><bpmn:exclusiveGateway id="G_PredictionInputs" name="Vstupy pre ML platné?" gatewayDirection="Diverging"><bpmn:incoming>F168</bpmn:incoming><bpmn:outgoing>F169</bpmn:outgoing><bpmn:outgoing>F170</bpmn:outgoing></bpmn:exclusiveGateway><bpmn:serviceTask id="T72" name="Zobraziť chybu vstupov"><bpmn:documentation>Zobraziť chybu z C# API bez volania Python, vytvorenia PredictionLinks alebo zápisu výsledku do Redis. Lekár môže opraviť pacienta, hospitalizáciu alebo lieky a skúsiť výpočet znova.
Pôvodný názov: Zobraziť chybu vstupov (400/404).</bpmn:documentation><bpmn:incoming>F170</bpmn:incoming><bpmn:outgoing>F171</bpmn:outgoing></bpmn:serviceTask><bpmn:sequenceFlow id="F001" sourceRef="Start_Admin" targetRef="T01"></bpmn:sequenceFlow><bpmn:sequenceFlow id="F002" sourceRef="T01" targetRef="T02"></bpmn:sequenceFlow><bpmn:sequenceFlow id="F003" sourceRef="T02" targetRef="G_AdminAuth"></bpmn:sequenceFlow><bpmn:sequenceFlow id="F004" sourceRef="G_AdminAuth" targetRef="T03" name="Nie"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">!valid_admin</bpmn:conditionExpression></bpmn:sequenceFlow><bpmn:sequenceFlow id="F005" sourceRef="T03" targetRef="T01" name="Opraviť"></bpmn:sequenceFlow><bpmn:sequenceFlow id="F006" sourceRef="G_AdminAuth" targetRef="T04" name="Áno"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">valid_admin</bpmn:conditionExpression></bpmn:sequenceFlow><bpmn:sequenceFlow id="F007" sourceRef="T04" targetRef="T05"></bpmn:sequenceFlow><bpmn:sequenceFlow id="F008" sourceRef="T05" targetRef="T06"></bpmn:sequenceFlow><bpmn:sequenceFlow id="F009" sourceRef="T06" targetRef="T07"></bpmn:sequenceFlow><bpmn:sequenceFlow id="F010" sourceRef="T07" targetRef="G_AccountMode"></bpmn:sequenceFlow><bpmn:sequenceFlow id="F011" sourceRef="G_AccountMode" targetRef="T08" name="Áno"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">new_account</bpmn:conditionExpression></bpmn:sequenceFlow><bpmn:sequenceFlow id="F012" sourceRef="G_AccountMode" targetRef="T09" name="Nie"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">!new_account</bpmn:conditionExpression></bpmn:sequenceFlow><bpmn:sequenceFlow id="F013" sourceRef="T08" targetRef="G_AccountMerge"></bpmn:sequenceFlow><bpmn:sequenceFlow id="F014" sourceRef="T09" targetRef="G_AccountMerge"></bpmn:sequenceFlow><bpmn:sequenceFlow id="F015" sourceRef="G_AccountMerge" targetRef="T10"></bpmn:sequenceFlow><bpmn:sequenceFlow id="F016" sourceRef="T10" targetRef="G_AccountValid"></bpmn: